{
  "$name": "Luca Ramseyer — Brand Tokens",
  "$description": "Single source of truth. Run build_tokens.py to regenerate tokens/tokens.css, tokens/theme.css and the :root block + embedded JSON in style-guide.html.",
  "$version": "1.1.0",
  "color": {
    "paper": {
      "hex": "#F4EFE4",
      "rgb": "244 239 228",
      "cmyk": "4 6 11 0",
      "role": "primary surface / paper"
    },
    "surface": {
      "hex": "#FBF8F1",
      "rgb": "251 248 241",
      "cmyk": "1 2 5 0",
      "role": "elevated panels / cards"
    },
    "ink": {
      "hex": "#211F1C",
      "rgb": "33 31 28",
      "cmyk": "40 30 30 100",
      "role": "wordmark / headings (print: rich black)"
    },
    "body": {
      "hex": "#423D37",
      "rgb": "66 61 55",
      "cmyk": "0 0 0 82",
      "role": "body text"
    },
    "muted": {
      "hex": "#6F685D",
      "rgb": "111 104 93",
      "cmyk": "0 6 16 56",
      "role": "captions / secondary text (4.8:1 on paper, passes WCAG AA)"
    },
    "stone": {
      "hex": "#857E72",
      "rgb": "133 126 114",
      "cmyk": "0 5 14 48",
      "role": "non-text only: icons, disabled states, chart series (3.5:1, too light for small text)"
    },
    "red": {
      "hex": "#C0473A",
      "rgb": "192 71 58",
      "cmyk": "0 65 72 22",
      "role": "accent — use sparingly"
    },
    "red-deep": {
      "hex": "#A63B30",
      "rgb": "166 59 48",
      "cmyk": "0 64 71 35",
      "role": "accent hover / pressed"
    },
    "line": {
      "hex": "#DAD2C4",
      "rgb": "218 210 196",
      "cmyk": "0 4 10 15",
      "role": "hairline rules / borders"
    },
    "good": {
      "hex": "#5B7A52",
      "rgb": "91 122 82",
      "cmyk": "25 0 33 52",
      "role": "positive / success, sparingly"
    }
  },
  "font": {
    "serif": "'Cormorant Garamond', 'Cormorant', Georgia, 'Times New Roman', serif",
    "sans": "'Montserrat', 'Helvetica Neue', Arial, sans-serif",
    "googleImport": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500;600&display=swap",
    "mono": "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "license": {
    "fonts": {
      "id": "SIL Open Font License 1.1",
      "url": "https://openfontlicense.org",
      "commercialUse": true,
      "attributionRequired": false,
      "note": "Free for personal & commercial use, including embedding and modification. Include the matching OFL file ONLY when redistributing the font FILES themselves (e.g. self-hosting webfonts or bundling in an app). Documents/exports (PDF, PNG, SVG) and Google Fonts CDN usage need NO license file.",
      "files": {
        "Cormorant Garamond": {
          "copyright": "Copyright 2015 The Cormorant Project Authors (github.com/CatharsisFonts/Cormorant)",
          "ofl": "fonts/OFL-CormorantGaramond.txt",
          "reservedFontName": false
        },
        "Montserrat": {
          "copyright": "Copyright 2024 The Montserrat Project Authors (github.com/JulietaUla/Montserrat)",
          "ofl": "fonts/OFL-Montserrat.txt",
          "reservedFontName": false
        }
      }
    }
  },
  "type": {
    "display": 56,
    "h1": 40,
    "h2": 30,
    "h3": 21,
    "body": 16,
    "small": 13,
    "eyebrow": 12
  },
  "tracking": {
    "wordmark": "0.24em",
    "label": "0.14em",
    "eyebrow": "0.22em"
  },
  "leading": {
    "body": 1.75,
    "tight": 1.15
  },
  "space": [
    8,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius": {
    "ui": "3px",
    "mark": "10%"
  },
  "motion": {
    "fast": "200ms",
    "press": "140ms",
    "enter": "500ms",
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "pressScale": "0.97"
  },
  "layout": {
    "maxWidth": "920px"
  },
  "dark": {
    "$description": "Dark theme, after the mono-dark wallpapers: ink ground, cream type, one accent. Applied via prefers-color-scheme.",
    "paper": "#1C1A18",
    "surface": "#24221F",
    "ink": "#F4EFE4",
    "body": "#CFC8BB",
    "muted": "#A39B8E",
    "red": "#DB6B5D",
    "red-deep": "#E58478",
    "line": "#36332E",
    "good": "#8FAE85"
  },
  "chart": {
    "$description": "Series order. Ink carries the main series; red only highlights the one value that matters.",
    "light": [
      "#211F1C",
      "#C0473A",
      "#857E72",
      "#5B7A52",
      "#C9BFAE"
    ],
    "dark": [
      "#F4EFE4",
      "#DB6B5D",
      "#A39B8E",
      "#8FAE85",
      "#5A554D"
    ]
  }
}
