{
  "$name": "Luca Ramseyer — Brand Tokens",
  "$description": "Single source of truth. Run build_tokens.py to regenerate tokens/tokens.css, tokens/theme.css and the :root block + embedded JSON in style-guide.html.",
  "$version": "1.0.0",

  "color": {
    "paper":    { "hex": "#F4EFE4", "rgb": "244 239 228", "cmyk": "4 6 11 0",  "role": "primary surface / paper" },
    "surface":  { "hex": "#FBF8F1", "rgb": "251 248 241", "cmyk": "1 2 5 0",   "role": "elevated panels / cards" },
    "ink":      { "hex": "#211F1C", "rgb": "33 31 28",    "cmyk": "40 30 30 100", "role": "wordmark / headings (print: rich black)" },
    "body":     { "hex": "#423D37", "rgb": "66 61 55",    "cmyk": "0 0 0 82",  "role": "body text" },
    "muted":    { "hex": "#857E72", "rgb": "133 126 114", "cmyk": "0 5 14 48", "role": "captions / secondary" },
    "red":      { "hex": "#C0473A", "rgb": "192 71 58",   "cmyk": "0 65 72 22","role": "accent — use sparingly" },
    "red-deep": { "hex": "#A63B30", "rgb": "166 59 48",   "cmyk": "0 64 71 35","role": "accent hover / pressed" },
    "line":     { "hex": "#DAD2C4", "rgb": "218 210 196", "cmyk": "0 4 10 15", "role": "hairline rules / borders" }
  },

  "font": {
    "serif": "'Cormorant Garamond', 'Cormorant', Georgia, 'Times New Roman', serif",
    "sans":  "'Montserrat', 'Helvetica Neue', Arial, sans-serif",
    "googleImport": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Montserrat:wght@300;400;500;600&display=swap"
  },

  "license": {
    "fonts": {
      "id": "SIL Open Font License 1.1",
      "url": "https://openfontlicense.org",
      "commercialUse": true,
      "attributionRequired": false,
      "note": "Free for personal & commercial use, including embedding and modification. Include the matching OFL file ONLY when redistributing the font FILES themselves (e.g. self-hosting webfonts or bundling in an app). Documents/exports (PDF, PNG, SVG) and Google Fonts CDN usage need NO license file.",
      "files": {
        "Cormorant Garamond": { "copyright": "Copyright 2015 The Cormorant Project Authors (github.com/CatharsisFonts/Cormorant)", "ofl": "fonts/OFL-CormorantGaramond.txt", "reservedFontName": false },
        "Montserrat": { "copyright": "Copyright 2024 The Montserrat Project Authors (github.com/JulietaUla/Montserrat)", "ofl": "fonts/OFL-Montserrat.txt", "reservedFontName": false }
      }
    }
  },

  "type": { "display": 56, "h1": 40, "h2": 30, "h3": 21, "body": 16, "small": 13, "eyebrow": 12 },
  "tracking": { "wordmark": "0.24em", "label": "0.14em", "eyebrow": "0.22em" },
  "leading": { "body": 1.75, "tight": 1.15 },
  "space": [8, 16, 24, 32, 48, 64, 96],
  "radius": { "ui": "3px", "mark": "10%" },
  "motion": { "fast": "200ms" },
  "layout": { "maxWidth": "920px" }
}
